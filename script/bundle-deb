#!/usr/bin/env bash

set -euxo pipefail

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .deb package for Linux.

Options:
  -h, --help     Display this help and exit.
  "
}

# Parse all arguments manually
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

export ZED_BUNDLE=true

target_dir="${CARGO_TARGET_DIR:-target}"

# Generate the licenses file so it can be baked into the package.
# ALLOW_MISSING_LICENSES lets it succeed even if cargo-about is unavailable.
ALLOW_MISSING_LICENSES=1 script/generate-licenses || true

version="$(script/get-crate-version wu)"
export RELEASE_VERSION="${version}"

commit=$(git rev-parse HEAD | cut -c 1-7)

export CC="${CC:-$(command -v clang)}"

# Build binary in release mode. Keep the crate's own binary names (`wu`, `cli`)
# here; they are renamed at packaging time (see the flatpak/snap manifests for
# the same convention).
cargo build --release --package wu --package cli

# Strip debug symbols to keep the package small.
llvm-objcopy --strip-debug "${target_dir}/release/wu"
llvm-objcopy --strip-debug "${target_dir}/release/cli"

# Collect the dynamically linked libraries the editor needs at runtime so the
# package works even when the host is missing them.
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    ldd "${target_dir}/release/wu" |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

# Assemble the file layout for the package in a staging directory.
channel=$(<crates/wu/RELEASE_CHANNEL)
suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

package_name="aayushicode${suffix}"
package_root="$(mktemp -d)"
install_dir="${package_root}/opt/aayushicode"

# Binaries. The editor lives under opt; the CLI binary is exposed via a
# symlink in /usr/bin.
mkdir -p "${install_dir}/bin" "${install_dir}/libexec" "${install_dir}/lib" "${package_root}/usr/bin"
cp "${target_dir}/release/wu" "${install_dir}/libexec/aayushicode-editor"
cp "${target_dir}/release/cli" "${install_dir}/bin/cli"
ln -s "/opt/aayushicode/libexec/aayushicode-editor" "${package_root}/usr/bin/aayushicode"
ln -s "/opt/aayushicode/bin/cli" "${package_root}/usr/bin/aayushicode-cli"

# Bundled libraries next to the editor binary (rpath "$ORIGIN/../lib").
mkdir -p "${install_dir}/lib"
cp $(find_libs) "${install_dir}/lib"

# App identity: the app ID doubles as the Wayland window ID, so an icon file
# named after it must be installed for compositors to show a window/taskbar icon.
APP_NAME="Aayushi Code"
APP_ID="me.aayush.Aayushi-Code"
if [ "$channel" == "dev" ]; then
  APP_NAME="Aayushi Code Dev"
  APP_ID="me.aayush.Aayushi-Code-Dev"
fi

# Icons. The generic `aayushicode` name covers the desktop entry's
# `Icon=aayushicode`; the app-id-named copy lets Wayland compositors resolve
# the window/taskbar icon (they look the icon up by the window's app_id).
mkdir -p "${package_root}/usr/share/icons/hicolor/512x512/apps"
cp "crates/wu/resources/app-icon${suffix}.png" "${package_root}/usr/share/icons/hicolor/512x512/apps/aayushicode.png"
cp "crates/wu/resources/app-icon${suffix}.png" "${package_root}/usr/share/icons/hicolor/512x512/apps/${APP_ID}.png"
mkdir -p "${package_root}/usr/share/icons/hicolor/1024x1024/apps"
cp "crates/wu/resources/app-icon${suffix}@2x.png" "${package_root}/usr/share/icons/hicolor/1024x1024/apps/aayushicode.png"
cp "crates/wu/resources/app-icon${suffix}@2x.png" "${package_root}/usr/share/icons/hicolor/1024x1024/apps/${APP_ID}.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="aayushicode"
export APP_ICON="aayushicode"
export APP_ARGS="%U"
export APP_NAME="${APP_NAME}"

mkdir -p "${package_root}/usr/share/applications"
envsubst < "crates/wu/resources/zed.desktop.in" > "${package_root}/usr/share/applications/${APP_ID}.desktop"
chmod +x "${package_root}/usr/share/applications/${APP_ID}.desktop"

# Generated licenses (`assets/licenses.md`) are created by generate-licenses.
# When that fails (e.g. cargo-about isn't installed), the package just omits
# the copyright file instead of failing the whole build.
if [ -f "assets/licenses.md" ]; then
  mkdir -p "${package_root}/usr/share/doc/${package_name}"
  cp "assets/licenses.md" "${package_root}/usr/share/doc/${package_name}/copyright"
fi

# DEBIAN control file
arch=$(uname -m)
case "$arch" in
  x86_64) dpkg_arch="amd64" ;;
  aarch64) dpkg_arch="arm64" ;;
  *) echo "Unsupported architecture: $arch" >&2; exit 1 ;;
esac

mkdir -p "${package_root}/DEBIAN"
cat > "${package_root}/DEBIAN/control" <<EOF
Package: ${package_name}
Version: ${version}-${commit}
Section: editors
Priority: optional
Architecture: ${dpkg_arch}
Maintainer: Aayush Pokhrel <info@aayushhpokhrel.com.np>
Installed-Size: $(du -sk "${package_root}/opt" | cut -f1)
Depends: libasound2 | libasound2t64, libglib2.0-0, libstdc++6, libssl3 | libssl1.1, libwayland-client0, libx11-6, libxcb1, libxkbcommon0, libxkbcommon-x11-0, libxi6, libxcursor1
Recommends: libvulkan1, xdg-desktop-portal, pipewire
Homepage: https://aayushhpokhrel.com.np
Description: Aayushi Code - a fast, native code editor
 A fast, native code editor built in Rust with a GPU-accelerated renderer.
 It pairs the speed of a native app with the familiarity of VS Code and
 stays out of your way.
EOF

# Refresh the hicolor icon cache and desktop database after install so the app
# icon appears in the desktop environment's launcher without requiring a logout.
cat > "${package_root}/DEBIAN/postinst" <<'EOF'
#!/bin/sh
set -e
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi
exit 0
EOF
chmod 755 "${package_root}/DEBIAN/postinst"

# Package it
deb_file="${package_name}_${version}-${commit}_${dpkg_arch}.deb"
fakeroot dpkg-deb --build "${package_root}" "${target_dir}/release/${deb_file}"

echo "Built ${deb_file}"